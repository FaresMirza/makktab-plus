# Database
DATABASE_URL="postgresql://user:password@localhost:5432/makktab_plus"

# Server
PORT=3000

# Auth
JWT_SECRET="change-me-in-production"

# Gmail SMTP (for OTP / transactional email)
# 1. Enable 2-Step Verification on the sending Google account
#    https://myaccount.google.com/security
# 2. Create an App Password (16-char value, no spaces) at
#    https://myaccount.google.com/apppasswords
# 3. Paste the App Password — NOT the regular Gmail password — into SMTP_PASSWORD
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
# Optional. Defaults to SMTP_USER.
SMTP_FROM="Makktab+ <your-gmail-address@gmail.com>"
